{{/* GitHub's underline tabs for a team's members and repositories, each with its counter. */}}
<nav class="theme-team-tabs" aria-label="{{.Team.Name}}">
	<a{{if .PageIsOrgTeamMembers}} aria-current="page"{{end}} href="{{.OrgLink}}/teams/{{.Team.LowerName | PathEscape}}">{{svg "octicon-person" 16}}{{ctx.Locale.Tr "org.members"}}<span class="theme-counter theme-counter-tab">{{.Team.NumMembers}}</span></a>
	<a{{if .PageIsOrgTeamRepos}} aria-current="page"{{end}} href="{{.OrgLink}}/teams/{{.Team.LowerName | PathEscape}}/repositories">{{svg "octicon-repo" 16}}{{ctx.Locale.Tr "user.repositories"}}<span class="theme-counter theme-counter-tab">{{.Team.NumRepos}}</span></a>
</nav>
