{{/* GitHub lists a repository's projects inside the issue sidebar layout, without the repository heading. */}}
{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository projects theme-sidebar-layout github-project-list" data-theme-sidebar="issue_sidebar_collapsed">
	{{template "repo/issue/sidebar" .}}
	<div class="ui container theme-sidebar-main">
		{{template "base/alert" .}}
		{{template "components/project/list/list" dict "Data" . "Heading" true}}
	</div>
</div>
{{template "base/footer" .}}
