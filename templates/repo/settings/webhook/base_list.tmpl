{{/* GitHub's webhooks list: the description, then each hook as a box row with its status, URL and actions. Shared by repository, organization, personal and site administration settings. */}}
<h4 class="ui top attached header">
	{{/* Settings pages pass their page title, which for organizations is just "Settings"; site administration passes
		each list's own title. */}}
	{{if .PageIsSettingsHooks}}{{ctx.Locale.Tr "repo.settings.hooks"}}{{else}}{{.Title}}{{end}}
	<div class="ui right">
		<div class="ui jump dropdown">
			<div class="ui primary tiny button">{{ctx.Locale.Tr "repo.settings.add_webhook"}}</div>
			{{template "repo/settings/webhook/link_menu" .}}
		</div>
	</div>
</h4>
<div class="ui attached segment">
	<p class="theme-settings-description">{{.Description}}</p>
	{{if .Webhooks}}
		<div class="flex-list">
			{{range .Webhooks}}
				<div class="flex-item flex-item-center">
					<div class="flex-item-leading">
						<span class="text {{if eq .LastStatus 1}}green{{else if eq .LastStatus 2}}red{{else}}grey{{end}}">{{svg "octicon-dot-fill" 16}}</span>
					</div>
					<div class="flex-item-main">
						<a class="flex-item-title gt-ellipsis" title="{{.URL}}" href="{{$.BaseLink}}/{{.ID}}">{{.URL}}</a>
					</div>
					<div class="flex-item-trailing">
						<a class="ui button" href="{{$.BaseLink}}/{{.ID}}" aria-label="{{ctx.Locale.Tr "edit"}}">{{svg "octicon-pencil"}}</a>
						<button class="ui red button delete-button" data-url="{{$.Link}}/delete" data-id="{{.ID}}" data-modal-id="delete-webhook" aria-label="{{ctx.Locale.Tr "remove"}}">{{svg "octicon-trash"}}</button>
					</div>
				</div>
			{{end}}
		</div>
	{{end}}
</div>
