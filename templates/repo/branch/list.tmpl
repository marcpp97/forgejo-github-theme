{{/* GitHub's branches page: a heading with New branch, the search, then the default branch and the other branches in
GitHub's branch tables. Forgejo's dialogs for creating, renaming and deleting a branch stay as they are. */}}
{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository branches github-branches">
	<div class="ui container">
		{{template "base/alert" .}}
		<div class="theme-list-heading">
			<div class="theme-list-title"><h1>{{ctx.Locale.Tr "repo.branches"}}</h1></div>
			{{if and .IsWriter (not .Repository.IsArchived) (not .Repository.IsMirror) .DefaultBranchBranch}}
				<button class="primary button theme-control show-create-branch-modal" data-branch-from="{{.DefaultBranchBranch.DBBranch.Name}}">{{ctx.Locale.Tr "repo.branch.new_branch"}}</button>
			{{end}}
		</div>
		<form class="ignore-dirty github-branches-search" method="get" role="search">
			{{template "components/common/search/search" dict "Kind" "icon" "Value" .Keyword "Placeholder" (ctx.Locale.Tr "search.branch_kind")}}
		</form>
		{{if and .DefaultBranchBranch (not .Keyword)}}
			{{template "components/repository/branch/table" dict "Page" . "Title" (ctx.Locale.Tr "repo.default_branch") "Default" .DefaultBranchBranch}}
		{{end}}
		{{if .Branches}}
			{{template "components/repository/branch/table" dict "Page" . "Title" (ctx.Locale.Tr "repo.branches") "Branches" .Branches}}
		{{else if .Keyword}}
			<div class="theme-empty">
				{{svg "octicon-git-branch" 24}}
				<h3>{{ctx.Locale.Tr "search.no_results"}}</h3>
			</div>
		{{end}}
		{{template "base/paginate" .}}
	</div>
</div>

<div class="ui g-modal-confirm delete modal" id="delete-branch">
	<div class="header">
		{{svg "octicon-trash"}}
		{{ctx.Locale.Tr "repo.branch.delete_html"}} <span class="name"></span>
	</div>
	<div class="content">
		<p>{{ctx.Locale.Tr "repo.branch.delete_desc"}}</p>
	</div>
	{{template "base/modal_actions_confirm" .}}
</div>

<dialog id="create-branch-modal">
	<article>
		<header>{{ctx.Locale.Tr "repo.branch.new_branch"}}</header>
		<form class="ui form" id="create-branch-form" action="" data-base-action="{{.Link}}/_new/branch/" method="post">
			<div class="content">
				<div class="field">
					{{ctx.Locale.Tr "repo.branch.create_new_branch"}}
					<span id="modal-create-branch-from-span"></span>
				</div>
				<div class="required field">
					<label for="new_branch_name">{{ctx.Locale.Tr "repo.branch.name"}}</label>
					<input id="new_branch_name" name="new_branch_name" required>
				</div>
			</div>
			{{template "base/modal_actions_confirm" (dict "ModalButtonTypes" "confirm")}}
		</form>
	</article>
</dialog>

<dialog id="rename-branch-modal">
	<article>
		<header>{{ctx.Locale.Tr "repo.settings.rename_branch"}}</header>
		<div class="content default-branch-warning">
			<div class="ui warning message">{{ctx.Locale.Tr "repo.branch.warning_rename_default_branch"}}</div>
		</div>
		<form class="ui form" action="{{$.Repository.Link}}/settings/rename_branch" method="post">
			<div class="content">
				<input name="from" type="hidden" required>
				<div class="field">
					<span class="label-branch-from" data-locale="{{ctx.Locale.Tr "repo.branch.rename_branch_to"}}"></span>
				</div>
				<div class="required field">
					<label for="to_branch_name">{{ctx.Locale.Tr "repo.branch.name"}}</label>
					<input id="to_branch_name" name="to" required>
				</div>
			</div>
			{{template "base/modal_actions_confirm" (dict "ModalButtonTypes" "confirm")}}
		</form>
	</article>
</dialog>
{{template "base/footer" .}}
