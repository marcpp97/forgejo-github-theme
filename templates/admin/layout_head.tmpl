		{{template "components/common/settings/context" dict "Icon" "octicon-server" "Title" (ctx.Locale.Tr "admin_panel") "Subtitle" AppName}}
	</div>
	<div class="ui container flex-container theme-settings">
		{{template "admin/navbar" .ctxData}}
