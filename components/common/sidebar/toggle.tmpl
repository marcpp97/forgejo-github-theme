<button type="button" class="theme-sidebar-toggle" data-theme-sidebar-toggle aria-expanded="true">{{svg "octicon-sidebar-collapse" 16}}Collapse sidebar</button>
{{/* Fits the sidebar beneath the navbar before the first paint; sidebar.js keeps it fitted while the page scrolls. */}}
<script>
	((sidebar) => sidebar?.style.setProperty("--theme-sidebar-offset", `${Math.max(0, Math.round(sidebar.getBoundingClientRect().top))}px`))(document.currentScript.closest(".theme-sidebar"));
</script>
